# Overrides for the MAINNET firewall. Applied only when NETWORK=mainnet is set explicitly in the shell:
#   NETWORK=mainnet npm start -w @agent-firewall/firewall      (or: npm run start:mainnet -w ...)
# The vault and registry stay on Arc testnet (not redeployed); only payments move to mainnet.
# Your Agent Wallet on Arc mainnet (from `circle wallet list`). The CLI session lives in ~/.circle-cli of the
# user running the firewall; the agent is started with a different HOME.
CIRCLE_AGENT_WALLET_ADDRESS=0x...
PAY_URL_PREFIXES=http://localhost:4300
# Mainnet demo seller payee (an address we hold the key for, so test payments are recoverable).
SELLER_ADDRESSES=sportsfeed=0x...
FIREWALL_PORT=4100
FIREWALL_DB=./firewall-mainnet.db
FIREWALL_PUBLIC_URL=http://localhost:4100
# Disable the local testnet signer and the testnet Gateway top-up in this instance.
BUYER_PRIVATE_KEY=
FUNDING=off
